# ─────────────────────────────────────────────────────────────
# PriceMaster — Environment Variables
# Copy this file to .env and fill in your actual values.
# .env is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# Supabase project URL  (Settings → API → Project URL)
VITE_SUPABASE_URL=https://xxxx.supabase.co

# Supabase anon/public key  (Settings → API → anon key)
# Safe to expose in the browser — RLS policies protect your data.
VITE_SUPABASE_ANON_KEY=eyJ...

# Supabase service_role key  (Settings → API → service_role key)
# ⚠️  NEVER expose this in the browser.
# Used only inside Supabase Edge Functions (server-side only).
# Set this in: Supabase Dashboard → Edge Functions → Secrets
SUPABASE_SERVICE_ROLE_KEY=eyJ...
